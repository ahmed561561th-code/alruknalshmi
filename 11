          </div>
          <div style="margin-top:8px; padding:8px; border:2px solid #000; text-align:center; font-size:18px;">
            ${diff < 0 ? `عجز نقدي: ${varianceAbs} ج.م` : (diff > 0 ? `زيادة نقدية: ${varianceAbs} ج.م` : `الدرج مطابق (0 ج.م)`)}
