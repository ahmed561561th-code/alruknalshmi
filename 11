    function buildGroupedCategorySales() {
      const validOrders = Object.values(state.orders).filter(o => o && o.status !== 'pending_online' && o.status !== 'rejected' && o.status !== 'cancelled');
      const grouped = {};

      validOrders.forEach(o => {
        (o.items || []).forEach(item => {
          const itemMeta = state.items[item.id];
          const catId = item.categoryId || itemMeta?.categoryId || '';
          const catName = state.categories[catId]?.name || 'أقسام أخرى';
          if (!grouped[catName]) {
            grouped[catName] = { items: {}, catTotalQty: 0, catTotalRevenue: 0 };
          }
          const iName = item.name;
          const qty = Number(item.qty || 1);
          const rev = qty * Number(item.price || 0);
          if (!grouped[catName].items[iName]) {
            grouped[catName].items[iName] = { qty: 0, revenue: 0 };
          }
          grouped[catName].items[iName].qty += qty;
          grouped[catName].items[iName].revenue += rev;
          grouped[catName].catTotalQty += qty;
          grouped[catName].catTotalRevenue += rev;
        });
      });
      return grouped;
    }

    function renderReports() {
      const validOrders = Object.entries(state.orders).filter(([_, o]) => o && o.status !== 'pending_online' && o.status !== 'rejected' && o.status !== 'cancelled');
      let totalSales = 0, cashSales = 0, visaSales = 0, visaCount = 0, takeawaySales = 0, deliverySales = 0;
      const driverTotals = {};

      validOrders.forEach(([_, o]) => {
        const t = Number(o.total || 0);
        totalSales += t;
        if (o.paymentMethod === 'visa') {
          visaSales += t;
          visaCount += 1;
        } else {
          cashSales += t;
        }
        if (o.type === 'takeaway') takeawaySales += t;
        else {
          deliverySales += t;
          if (o.driverId) {
            if (!driverTotals[o.driverId]) driverTotals[o.driverId] = { name: o.driverName, count: 0, cash: 0, fees: 0 };
            driverTotals[o.driverId].count += 1;
            driverTotals[o.driverId].cash += t;
            driverTotals[o.driverId].fees += Number(o.deliveryFee || 0);
          }
        }
      });

      const repTotalSalesEl = document.getElementById('repTotalSales');
      if (!repTotalSalesEl) return;

      repTotalSalesEl.textContent = `${totalSales} ج.م`;
      document.getElementById('repCashSales').textContent = `${cashSales} ج.م`;
      document.getElementById('repVisaSales').textContent = `${visaSales} ج.م`;
