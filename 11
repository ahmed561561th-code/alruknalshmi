  <!-- منطقة الطباعة الحرارية المخفية -->
  <div id="printArea" class="hidden"></div>
  <iframe id="silentPrintFrame" style="position:fixed;right:0;bottom:0;width:0;height:0;border:0;visibility:hidden;"></iframe>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
    import { getDatabase, ref, set, push, update, remove, onValue, runTransaction } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-database.js";

    const MENU_ORDER_URL = "https://alroknalshami.blogspot.com/";
    const LOCAL_SNAPSHOT_KEY = "rukn_pos_offline_snapshot_v2";
    const LOCAL_MONTH_LEDGER_KEY = "rukn_pos_month_ledger_v2";

    const firebaseConfig = {
      databaseURL: "https://alrukn-90cc9-default-rtdb.firebaseio.com/"
    };
    const app = initializeApp(firebaseConfig);
    const db = getDatabase(app);

    const calendarTodayStr = () => new Date().toISOString().split('T')[0];

    let state = {
      categories: {},
      items: {},
      zones: {},
      drivers: {},
      customers: {},
      orders: {},
      monthLedger: [],
      presetNotes: ['حار', 'سبايسي', 'بدون عيش', 'بدون ثومية', 'زيادة صوص', 'بدون مخلل', 'متحمص زيادة'],
      storePhones: { phone1: '01000000000', phone2: '01100000000' },
      auth: { cashierUser: 'cashier', cashierPass: '1234', adminPass: 'admin123' },
      storeOpen: true,
      shiftDate: calendarTodayStr(),
      orderCounter: 1,
      selectedCat: 'ALL',
      orderType: 'takeaway',
      paymentMethod: 'cash',
      ordersFilter: 'all',
      selectedSettlementDriverId: '',
      editingOrderId: null,
      editingOnlineOrderId: null,
      cancellingOrderId: null,
      editingCategoryId: null,
      editingItemId: null,
      cart: [],
      editingNoteIndex: null
    };

    const todayStr = () => state.shiftDate || calendarTodayStr();

    function formatShiftDateLabel(isoDate) {
      const [y, m, d] = (isoDate || calendarTodayStr()).split('-').map(Number);
      const dt = new Date(y || 2026, (m || 1) - 1, d || 1);
      return dt.toLocaleDateString('ar-EG', { weekday: 'long', year: 'numeric', month: 'short', day: 'numeric' });
    }

    function updateClockAndNetBadge() {
      const now = new Date();
      const dateEl = document.getElementById('liveDateText');
      const clockEl = document.getElementById('liveClockText');
      const netEl = document.getElementById('netModeBadge');
      if (dateEl) dateEl.textContent = formatShiftDateLabel(todayStr());
      if (clockEl) clockEl.textContent = now.toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      if (netEl) {
        if (navigator.onLine) {
          netEl.textContent = '🌐 أونلاين';
          netEl.className = 'px-2 py-0.5 rounded-lg text-[10px] font-black bg-emerald-900 text-emerald-300';
        } else {
          netEl.textContent = '⚡ أوفلاين (حفظ محلي)';
          netEl.className = 'px-2 py-0.5 rounded-lg text-[10px] font-black bg-amber-600 text-slate-950 animate-pulse';
        }
      }
    }
    setInterval(updateClockAndNetBadge, 1000);
    updateClockAndNetBadge();

    window.toggleSidebar = (open) => {
      const drawer = document.getElementById('sideMenuDrawer');
      const backdrop = document.getElementById('sidebarBackdrop');
      if (open) {
        drawer.classList.remove('translate-x-full');
        backdrop.classList.remove('hidden');
      } else {
        drawer.classList.add('translate-x-full');
        backdrop.classList.add('hidden');
      }
    };

    function persistLocalSnapshot() {
      try {
        const snapshot = {
          savedAt: Date.now(),
          categories: state.categories || {},
          items: state.items || {},
          zones: state.zones || {},
          drivers: state.drivers || {},
          customers: state.customers || {},
          orders: state.orders || {},
          shiftDate: state.shiftDate,
          orderCounter: state.orderCounter,
          storeOpen: state.storeOpen,
          presetNotes: state.presetNotes,
          storePhones: state.storePhones,
          auth: state.auth
        };
        localStorage.setItem(LOCAL_SNAPSHOT_KEY, JSON.stringify(snapshot));
        localStorage.setItem(LOCAL_MONTH_LEDGER_KEY, JSON.stringify(state.monthLedger || []));
      } catch (e) {}
    }

    // رسم كل واجهات النظام فوراً من الحالة الحالية (مهم جداً للأوفلاين وعند تحديث الصفحة)
    function renderAllFromState() {
      document.getElementById('nextOrderBadge').textContent = `#${state.orderCounter}`;
      renderCategories();
      renderPosItems();
      renderItemsMgmtTable();
      renderMgmtNotesList();
      renderPresetNotesChips();
      renderZones();
      renderDrivers();
      renderCustomersTable();
      renderOrdersPage();
      renderActiveDelivery();
      renderDriverSettlement();
      renderReports();
      renderMonthSales();
      updateStoreToggleButtonUI();
    }

    function loadLocalSnapshotOnStart() {
      try {
        const raw = localStorage.getItem(LOCAL_SNAPSHOT_KEY) || localStorage.getItem("rukn_pos_offline_snapshot_v1");
        if (raw) {
          const snap = JSON.parse(raw);
          if (snap.categories && Object.keys(snap.categories).length > 0) state.categories = snap.categories;
          if (snap.items && Object.keys(snap.items).length > 0) state.items = snap.items;
          if (snap.zones && Object.keys(snap.zones).length > 0) state.zones = snap.zones;
          if (snap.drivers && Object.keys(snap.drivers).length > 0) state.drivers = snap.drivers;
          if (snap.customers && Object.keys(snap.customers).length > 0) state.customers = snap.customers;
          if (snap.orders) state.orders = snap.orders;
          state.shiftDate = snap.shiftDate || calendarTodayStr();
          state.orderCounter = snap.orderCounter || 1;
          state.storeOpen = snap.storeOpen !== undefined ? snap.storeOpen : true;
          if (Array.isArray(snap.presetNotes) && snap.presetNotes.length > 0) state.presetNotes = snap.presetNotes;
          if (snap.storePhones) state.storePhones = { ...state.storePhones, ...snap.storePhones };
          if (snap.auth) state.auth = { ...state.auth, ...snap.auth };
        }
        const ledgerRaw = localStorage.getItem(LOCAL_MONTH_LEDGER_KEY) || localStorage.getItem("rukn_pos_month_ledger_v1");
        if (ledgerRaw) {
          state.monthLedger = JSON.parse(ledgerRaw) || [];
        }
        if (sessionStorage.getItem('rukn_cashier_logged') === 'true') {
          document.getElementById('cashierLoginScreen').classList.add('hidden');
        }
      } catch (e) {}
      renderAllFromState();
    }

    function recordOrderInMonthLedger(order) {
      if (!order || order.status === 'pending_online' || order.status === 'rejected' || order.status === 'cancelled') return;
      const dStr = (order.date || todayStr());
      const entry = {
        id: order.id || `${order.orderNumber}_${order.createdAt || Date.now()}`,
        orderNumber: order.orderNumber,
        date: dStr,
        type: order.type || 'takeaway',
        paymentMethod: order.paymentMethod || 'cash',
        customerName: order.customer?.name || 'عميل نقدي/تيك أواي',
        total: Number(order.total || 0),
        rawOrder: order
      };
      const idx = state.monthLedger.findIndex(x => String(x.id) === String(entry.id));
      if (idx >= 0) state.monthLedger[idx] = entry;
      else state.monthLedger.unshift(entry);
      persistLocalSnapshot();
      renderMonthSales();
    }

    window.clearAllMonthOperations = async () => {
      if (!confirm('هل أنت متأكد من حذف جميع عمليات الشهر بالكامل؟ لن يتم إلغاء أوردرات اليوم الجاري.')) return;
      state.monthLedger = [];
      try {
        await remove(ref(db, 'monthLedger'));
      } catch (e) {}
      persistLocalSnapshot();
      renderMonthSales();
      showToastModal('تم حذف جميع عمليات الشهر بالكامل بنجاح', '🗑️');
    };

    window.downloadBackupFile = (mode = 'manual') => {
      persistLocalSnapshot();
      const payload = {
        exportedAt: new Date().toISOString(),
        mode,
        snapshot: JSON.parse(localStorage.getItem(LOCAL_SNAPSHOT_KEY) || '{}'),
        monthLedger: state.monthLedger
      };
      const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `alrukn-backup-${todayStr()}-${mode}.json`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
      const stEl = document.getElementById('lastBackupStatusText');
      if (stEl) stEl.textContent = `آخر نسخة احتياطية (${mode === 'auto-power-loss' ? 'تلقائية عند فصل الاتصال' : 'يدوية'}): ${new Date().toLocaleTimeString('ar-EG')}`;
    };

    window.restoreBackupFile = async (event) => {
      const file = event.target.files?.[0];
      if (!file) return;
      try {
        const text = await file.text();
        const parsed = JSON.parse(text);
        const snap = parsed.snapshot || parsed;
        if (snap.categories) { state.categories = snap.categories; await set(ref(db, 'categories'), snap.categories); }
        if (snap.items) { state.items = snap.items; await set(ref(db, 'items'), snap.items); }
        if (snap.zones) { state.zones = snap.zones; await set(ref(db, 'zones'), snap.zones); }
        if (snap.drivers) { state.drivers = snap.drivers; await set(ref(db, 'drivers'), snap.drivers); }
        if (snap.customers) { state.customers = snap.customers; await set(ref(db, 'customers'), snap.customers); }
        if (snap.orders) { state.orders = snap.orders; await set(ref(db, 'orders'), snap.orders); }
        if (snap.shiftDate) { state.shiftDate = snap.shiftDate; await set(ref(db, 'meta/shiftDate'), snap.shiftDate); }
        if (snap.orderCounter) { state.orderCounter = snap.orderCounter; await set(ref(db, 'meta/dailyCounter'), snap.orderCounter); }
        if (Array.isArray(parsed.monthLedger)) {
          state.monthLedger = parsed.monthLedger;
        }
        persistLocalSnapshot();
        renderAllFromState();
        updateClockAndNetBadge();
        showToastModal('تم رفع واستعادة النسخة الاحتياطية بنجاح!', '⬆️');
      } catch (err) {
        showToastModal('ملف النسخة الاحتياطية غير صالح!', '⚠️');
      }
      event.target.value = '';
    };

    window.addEventListener('offline', () => {
      updateClockAndNetBadge();
      persistLocalSnapshot();
      renderAllFromState();
    });
    window.addEventListener('online', () => {
      updateClockAndNetBadge();
      persistLocalSnapshot();
    });
    window.addEventListener('beforeunload', () => {
      persistLocalSnapshot();
    });

    // تحميل وعرض البيانات المحلية فوراً قبل انتظار Firebase
    loadLocalSnapshotOnStart();

    onValue(ref(db, 'meta/shiftDate'), (snap) => {
      if (snap.val()) {
        state.shiftDate = snap.val();
      } else if (navigator.onLine) {
        set(ref(db, 'meta/shiftDate'), state.shiftDate);
      }
      updateClockAndNetBadge();
      persistLocalSnapshot();
    });

    onValue(ref(db, 'storePhones'), (snap) => {
      if (snap.val()) {
        state.storePhones = { ...state.storePhones, ...snap.val() };
      }
      const p1 = document.getElementById('storePhone1Input');
      const p2 = document.getElementById('storePhone2Input');
      if (p1) p1.value = state.storePhones.phone1 || '';
      if (p2) p2.value = state.storePhones.phone2 || '';
      persistLocalSnapshot();
    });

    onValue(ref(db, 'systemAuth'), (snap) => {
      if (snap.val()) {
        state.auth = { ...state.auth, ...snap.val() };
      }
      document.getElementById('cfgCashierUser').value = state.auth.cashierUser;
      document.getElementById('cfgCashierPass').value = state.auth.cashierPass;
      document.getElementById('cfgAdminPass').value = state.auth.adminPass;
      persistLocalSnapshot();

      if (sessionStorage.getItem('rukn_cashier_logged') === 'true') {
        document.getElementById('cashierLoginScreen').classList.add('hidden');
      }
    });

    window.loginCashier = () => {
      const u = document.getElementById('loginCashierUser').value.trim();
      const p = document.getElementById('loginCashierPass').value.trim();
      if (u === state.auth.cashierUser && p === state.auth.cashierPass) {
        sessionStorage.setItem('rukn_cashier_logged', 'true');
        document.getElementById('cashierLoginScreen').classList.add('hidden');
        renderAllFromState();
      } else {
        showToastModal('اسم المستخدم أو كلمة المرور الخاصة بالكاشير غير صحيحة!', '🔐');
      }
    };

    window.logoutCashier = () => {
      sessionStorage.removeItem('rukn_cashier_logged');
      document.getElementById('cashierLoginScreen').classList.remove('hidden');
    };

    window.saveAuthSettings = async () => {
      const cashierUser = document.getElementById('cfgCashierUser').value.trim() || 'cashier';
      const cashierPass = document.getElementById('cfgCashierPass').value.trim() || '1234';
      const adminPass = document.getElementById('cfgAdminPass').value.trim() || 'admin123';
      state.auth = { cashierUser, cashierPass, adminPass };
      persistLocalSnapshot();
      try {
        await set(ref(db, 'systemAuth'), { cashierUser, cashierPass, adminPass });
      } catch (e) {}
      showToastModal('تم حفظ يوزر وباسورد الكاشير وباسورد المدير بنجاح', '🔐');
    };

    window.showToastModal = (msg, icon = '✅') => {
      document.getElementById('toastModalIcon').textContent = icon;
      document.getElementById('toastModalMsg').textContent = msg;
      document.getElementById('toastModal').classList.remove('hidden');
    };
    window.closeToastModal = () => {
      document.getElementById('toastModal').classList.add('hidden');
    };

    window.playDeliveryDeliveredAlertSound = () => {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(660, ctx.currentTime);
        osc.frequency.setValueAtTime(990, ctx.currentTime + 0.14);
        osc.frequency.setValueAtTime(1240, ctx.currentTime + 0.28);
        gain.gain.setValueAtTime(0.45, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.55);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.55);
      } catch (e) {}
    };

    let knownDeliveredIds = new Set();
    let initialOrdersLoaded = false;

    function updateStoreToggleButtonUI() {
      const btn = document.getElementById('storeToggleBtn');
      if (!btn) return;
      if (state.storeOpen) {
        btn.className = 'px-3 py-2 rounded-xl font-black text-xs transition shadow flex items-center gap-1.5 bg-emerald-600 hover:bg-emerald-700 text-white';
        btn.innerHTML = '<span>🟢 المحل مفتوح (اضغط للإغلاق)</span>';
      } else {
        btn.className = 'px-3 py-2 rounded-xl font-black text-xs transition shadow flex items-center gap-1.5 bg-red-600 hover:bg-red-700 text-white animate-pulse';
        btn.innerHTML = '<span>🔴 المحل مغلق (اضغط للتشغيل)</span>';
      }
    }

    onValue(ref(db, 'storeStatus'), (snap) => {
      const val = snap.val();
      if (val !== null && val !== undefined) {
        state.storeOpen = !(val === false || val === 'closed' || val === 'مغلق' || (val && val.isOpen === false));
        updateStoreToggleButtonUI();
        persistLocalSnapshot();
      }
    });

    window.toggleStoreOpenStatus = async () => {
      const nextState = !state.storeOpen;
      state.storeOpen = nextState;
      updateStoreToggleButtonUI();
      persistLocalSnapshot();
      try {
        await set(ref(db, 'storeStatus'), { isOpen: nextState, updatedAt: Date.now() });
      } catch (e) {}
      showToastModal(nextState ? 'تم فتح المحل على صفحة المنيو' : 'تم إغلاق المحل على صفحة المنيو', nextState ? '🟢' : '🔴');
    };

    onValue(ref(db, 'presetNotes'), (snap) => {
      if (snap.val()) {
        state.presetNotes = Object.values(snap.val()).filter(Boolean);
        renderMgmtNotesList();
        renderPresetNotesChips();
        persistLocalSnapshot();
      }
    });

