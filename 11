    window.calculateShiftVariancePreview = () => {
      const { cashSales } = getShiftCashAndVisaTotals();
      const rawActual = document.getElementById('actualCashDrawerInput').value;
      const actual = rawActual === '' ? cashSales : Number(rawActual);
      const diff = actual - cashSales;
      const box = document.getElementById('shiftVarianceBox');
      const lbl = document.getElementById('shiftVarianceLabel');

      if (diff < 0) {
        box.className = 'p-3.5 rounded-2xl border-2 border-red-500 bg-red-50 text-center font-black text-base';
        lbl.className = 'text-red-700';
        lbl.textContent = `⚠️ يوجد عجز نقدي: ${Math.abs(diff)} ج.م`;
      } else if (diff > 0) {
        box.className = 'p-3.5 rounded-2xl border-2 border-amber-500 bg-amber-50 text-center font-black text-base';
        lbl.className = 'text-amber-900';
        lbl.textContent = `📈 يوجد زيادة نقدية: ${diff} ج.م`;
      } else {
        box.className = 'p-3.5 rounded-2xl border-2 border-emerald-500 bg-emerald-50 text-center font-black text-base';
        lbl.className = 'text-emerald-800';
        lbl.textContent = `✅ النقدي مطابق تماماً (الفرق: 0 ج.م)`;
      }
    };

    window.confirmCloseDayShift = async () => {
      const { validOrders, totalSales, cashSales, visaSales } = getShiftCashAndVisaTotals();
      const rawActual = document.getElementById('actualCashDrawerInput').value;
      if (rawActual === '' || isNaN(Number(rawActual))) {
        return showToastModal('يرجى إدخال المبلغ النقدي الفعلي في الدرج أولاً!', '⚠️');
      }

      const actualCash = Number(rawActual);
      const diff = actualCash - cashSales;
      const varianceStatus = diff < 0 ? 'عجز' : (diff > 0 ? 'زيادة' : 'مطابق');
      const varianceAbs = Math.abs(diff);
      const closedAtText = new Date().toLocaleString('ar-EG');
      const closedShiftDate = todayStr();
      const nextShiftDate = calendarTodayStr();

      Object.entries(state.orders).forEach(([id, o]) => {
        if (o && o.status !== 'pending_online' && o.status !== 'rejected' && o.status !== 'cancelled') {
          recordOrderInMonthLedger({ id, ...o, date: closedShiftDate });
        }
      });

      try {
        await push(ref(db, 'archivedShifts'), {
          closedAt: Date.now(),
          date: closedShiftDate,
          ordersCount: validOrders.length,
          totalSales,
          cashSales,
          visaSales,
          actualCash,
          diff,
          varianceStatus,
          orders: state.orders
        });

        await remove(ref(db, 'orders'));
        await set(ref(db, 'meta/dailyCounter'), 1);
        await set(ref(db, 'meta/shiftDate'), nextShiftDate);
