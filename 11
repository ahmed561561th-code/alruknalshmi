    window.dispatchDriver = async (orderId) => {
      const driverId = document.getElementById(`assignDriver_${orderId}`).value;
      if (!driverId) return showToastModal('اختر الطيار أولاً!', '⚠️');
      const driverName = state.drivers[driverId]?.name || '';
      await update(ref(db, `orders/${orderId}`), {
        driverId,
        driverName,
        driverAccepted: false,
        settledInVault: false,
        status: 'out_for_delivery',
        dispatchedAt: Date.now()
      });
      showToastModal(`تم إرسال الأوردر للطيار (${driverName}) وجاري الرنين على هاتفه`, '🛵');
