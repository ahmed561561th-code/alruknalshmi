            <td style="text-align:left; padding:5px 2px; font-size:15px;">${info.revenue}</td>
          </tr>
        `).join('');
        return `
          <div style="margin-top:8px; border:2px solid #000; border-radius:4px; padding:5px;">
            <div style="font-size:16px; font-weight:900; background:#e5e7eb; padding:4px 6px; border-bottom:1px solid #000;">${catName} (${g.catTotalRevenue} ج.م)</div>
            <table style="width:100%; border-collapse:collapse; font-weight:900; margin-top:3px; font-family:'Tajawal',sans-serif;">
              <thead>
                <tr style="border-bottom:1px solid #000; font-size:14px;">
                  <th style="text-align:right; padding:3px 2px;">الصنف</th>
                  <th style="text-align:center; padding:3px 2px;">العدد</th>
                  <th style="text-align:left; padding:3px 2px;">الإجمالي</th>
                </tr>
              </thead>
              <tbody>${rows}</tbody>
            </table>
          </div>
        `;
      }).join('');

      const html = `
        <div style="width:76mm; font-family:'Tajawal',sans-serif; direction:rtl; color:#000; padding:5px; border:3px solid #000; font-weight:900;">
          <div style="text-align:center; border-bottom:2px solid #000; padding-bottom:6px;">
            <div style="font-size:21px;">مطعم الركن الشامي</div>
            <div style="font-size:16px; margin-top:2px;">تقرير مبيعات الأصناف (80mm)</div>
            <div style="font-size:12px; font-weight:700; margin-top:2px;">${todayStr()} — ${new Date().toLocaleTimeString('ar-EG')}</div>
          </div>
          ${sectionsHtml || '<div style="text-align:center; padding:12px; font-size:15px;">لا توجد مبيعات أصناف</div>'}
          <div style="margin-top:10px; font-size:18px; display:flex; justify-content:space-between; border-top:2px solid #000; padding-top:6px;">
            <span>إجمالي الأصناف:</span>
            <span>${grandTotal} ج.م</span>
          </div>
          ${getStorePhonesFooterHTML()}
        </div>
      `;

      await printSingleTicket(html, localStorage.getItem('cashierPrinter'));
      showToastModal('تمت طباعة تقرير الأصناف بالأقسام بمقاس 80mm', '🖨️');
    };

