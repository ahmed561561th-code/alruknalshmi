<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>الركن الشامي - نظام الكاشير والإدارة المتكامل</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@500;700;800;900&display=swap" rel="stylesheet">
  <style>
    * { font-family: 'Tajawal', sans-serif !important; }
    body { font-family: 'Tajawal', sans-serif; background-color: #f1f5f9; user-select: none; }
    .tab-active { background-color: #b91c1c; color: #ffffff; box-shadow: 0 4px 12px rgba(185, 28, 88, 0.3); }
    .online-ring { animation: pulseRing 1.2s infinite; }
    @keyframes pulseRing {
      0% { box-shadow: 0 0 0 0 rgba(234, 179, 8, 0.85); }
      70% { box-shadow: 0 0 0 14px rgba(234, 179, 8, 0); }
      100% { box-shadow: 0 0 0 0 rgba(234, 179, 8, 0); }
    }
    @media print {
      body * { visibility: hidden; }
      #printArea, #printArea * { visibility: visible; font-family: 'Tajawal', sans-serif !important; }
      #printArea {
        position: absolute;
        left: 0;
        top: 0;
        width: 78mm;
        font-family: 'Tajawal', sans-serif !important;
        color: #000;
      }
      @page { size: 80mm auto; margin: 1.5mm; }
    }
  </style>
</head>
<body class="h-screen flex flex-col overflow-hidden">

  <!-- شاشة تسجيل دخول الكاشير -->
  <div id="cashierLoginScreen" class="fixed inset-0 bg-slate-950 z-50 flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-700 w-full max-w-md rounded-3xl p-6 text-white shadow-2xl space-y-4">
      <div class="text-center space-y-1">
        <div class="inline-block bg-red-600 text-white font-black px-4 py-1.5 rounded-xl text-lg">الركن الشامي</div>
        <h1 class="text-2xl font-black pt-1">🔐 تسجيل دخول الكاشير</h1>
        <p class="text-xs text-slate-400 font-bold">أدخل اسم المستخدم وكلمة المرور الخاصة بالكاشير</p>
      </div>
      <div>
        <label class="block text-xs font-bold text-slate-300 mb-1">اسم المستخدم (Username)</label>
        <input type="text" id="loginCashierUser" placeholder="cashier" class="w-full p-3 rounded-2xl bg-slate-800 border border-slate-600 text-white font-black text-sm outline-none focus:border-amber-400">
      </div>
      <div>
        <label class="block text-xs font-bold text-slate-300 mb-1">كلمة المرور (Password)</label>
        <input type="password" id="loginCashierPass" placeholder="••••" class="w-full p-3 rounded-2xl bg-slate-800 border border-slate-600 text-white font-black text-sm outline-none focus:border-amber-400">
      </div>
      <button onclick="loginCashier()" class="w-full bg-red-600 hover:bg-red-700 text-white py-3.5 rounded-2xl font-black text-base shadow-lg transition">
        🚀 دخول إلى نظام الكاشير
      </button>
    </div>
  </div>

  <!-- القائمة الجانبية (Sidebar) -->
  <div id="sidebarBackdrop" onclick="toggleSidebar(false)" class="hidden fixed inset-0 bg-black/60 z-40"></div>
  <aside id="sideMenuDrawer" class="fixed top-0 right-0 h-full w-72 bg-slate-900 text-white z-50 transform translate-x-full transition-transform duration-200 shadow-2xl border-l border-slate-700 flex flex-col">
    <div class="p-4 border-b border-slate-800 flex items-center justify-between">
      <div>
        <div class="text-base font-black text-amber-400">الركن الشامي</div>
        <div class="text-[11px] text-slate-400 font-bold">القائمة الرئيسية للنظام</div>
      </div>
      <button onclick="toggleSidebar(false)" class="w-8 h-8 rounded-xl bg-slate-800 hover:bg-slate-700 font-black text-sm">✕</button>
    </div>
    <nav class="flex-1 p-3 space-y-1.5 overflow-y-auto">
      <button onclick="switchTab('pos'); toggleSidebar(false);" id="nav-pos" class="tab-btn tab-active w-full text-right px-3.5 py-2.5 rounded-xl font-bold text-xs transition flex items-center gap-2">
        <span>🛒 الكاشير</span>
      </button>
      <button onclick="switchTab('ordersPage'); toggleSidebar(false);" id="nav-ordersPage" class="tab-btn w-full text-right bg-slate-800 hover:bg-slate-700 px-3.5 py-2.5 rounded-xl font-bold text-xs transition flex items-center gap-2">
        <span>📦 أوردرات اليوم</span>
      </button>
      <button onclick="switchTab('online'); toggleSidebar(false);" id="nav-online" class="tab-btn w-full text-right bg-slate-800 hover:bg-slate-700 px-3.5 py-2.5 rounded-xl font-bold text-xs transition flex items-center justify-between relative">
        <span class="flex items-center gap-2"><span>🔔 طلبات الأونلاين</span></span>
        <span id="onlineBadge" class="bg-amber-500 text-slate-950 text-xs font-black px-2 py-0.5 rounded-full">0</span>
      </button>
      <button onclick="switchTab('activeDelivery'); toggleSidebar(false);" id="nav-activeDelivery" class="tab-btn w-full text-right bg-slate-800 hover:bg-slate-700 px-3.5 py-2.5 rounded-xl font-bold text-xs transition flex items-center gap-2">
        <span>🛵 متابعة الدليفري</span>
      </button>
      <button onclick="switchTab('driverSettlement'); toggleSidebar(false);" id="nav-driverSettlement" class="tab-btn w-full text-right bg-slate-800 hover:bg-slate-700 px-3.5 py-2.5 rounded-xl font-bold text-xs transition flex items-center justify-between relative">
        <span class="flex items-center gap-2"><span>💰 تحصيل الطيارين</span></span>
        <span id="settlementBadge" class="hidden bg-emerald-400 text-slate-950 text-[10px] font-black px-1.5 py-0.5 rounded-full">!</span>
      </button>
      <button onclick="switchTab('menuMgmt'); toggleSidebar(false);" id="nav-menuMgmt" class="tab-btn w-full text-right bg-slate-800 hover:bg-slate-700 px-3.5 py-2.5 rounded-xl font-bold text-xs transition flex items-center gap-2">
        <span>🍔 الأصناف والملاحظات</span>
      </button>
      <button onclick="switchTab('zonesDrivers'); toggleSidebar(false);" id="nav-zonesDrivers" class="tab-btn w-full text-right bg-slate-800 hover:bg-slate-700 px-3.5 py-2.5 rounded-xl font-bold text-xs transition flex items-center gap-2">
        <span>🗺️ المناطق والطيارين</span>
      </button>
      <button onclick="switchTab('customers'); toggleSidebar(false);" id="nav-customers" class="tab-btn w-full text-right bg-slate-800 hover:bg-slate-700 px-3.5 py-2.5 rounded-xl font-bold text-xs transition flex items-center gap-2">
        <span>👥 العملاء</span>
      </button>
      <button onclick="switchTab('reports'); toggleSidebar(false);" id="nav-reports" class="tab-btn w-full text-right bg-slate-800 hover:bg-slate-700 px-3.5 py-2.5 rounded-xl font-bold text-xs transition flex items-center gap-2">
        <span>📊 التقارير والتقفيل</span>
      </button>
      <button onclick="switchTab('monthSales'); toggleSidebar(false);" id="nav-monthSales" class="tab-btn w-full text-right bg-slate-800 hover:bg-slate-700 px-3.5 py-2.5 rounded-xl font-bold text-xs transition flex items-center gap-2">
        <span>📅 فواتير الأيام</span>
      </button>
      <button onclick="switchTab('settings'); toggleSidebar(false);" id="nav-settings" class="tab-btn w-full text-right bg-slate-800 hover:bg-slate-700 px-3.5 py-2.5 rounded-xl font-bold text-xs transition flex items-center gap-2">
        <span>🖨️ الطابعات والنسخ الاحتياطي</span>
      </button>
    </nav>
  </aside>

  <!-- الشريط العلوي -->
  <header class="bg-slate-900 text-white px-3 py-2 flex items-center justify-between shadow-lg z-20 gap-2">
    <div class="flex items-center gap-2 flex-wrap">
      <button onclick="toggleSidebar(true)" class="bg-slate-800 hover:bg-slate-700 border border-slate-600 text-amber-400 px-3 py-2 rounded-xl font-black text-xs transition flex items-center gap-1.5">
        <span>☰</span>
        <span>القائمة</span>
      </button>
      <div class="bg-red-600 text-white font-black text-base px-3 py-1 rounded-xl">الركن الشامي</div>
      <div class="hidden sm:block">
        <div class="text-[10px] text-slate-400">رقم الأوردر القادم</div>
        <div id="nextOrderBadge" class="text-sm font-black text-amber-400 leading-none">#1</div>
      </div>

      <!-- زر طلبات أونلاين ظاهر مباشرة في الشريط العلوي -->
      <button onclick="switchTab('online')" id="topOnlineQuickBtn" class="px-3 py-2 rounded-xl font-black text-xs transition shadow flex items-center gap-1.5 bg-amber-500 hover:bg-amber-400 text-slate-950">
        <span>🔔 طلبات أونلاين</span>
        <span id="topOnlineBadge" class="bg-slate-950 text-amber-400 text-xs font-black px-2 py-0.5 rounded-full">0</span>
      </button>

      <button onclick="toggleStoreOpenStatus()" id="storeToggleBtn" class="px-3 py-2 rounded-xl font-black text-xs transition shadow flex items-center gap-1.5 bg-emerald-600 hover:bg-emerald-700 text-white">
        <span>🟢 المحل مفتوح (اضغط للإغلاق)</span>
      </button>
    </div>

    <!-- التاريخ والوقت الحي بالثواني -->
    <div class="hidden xl:flex items-center gap-3 bg-slate-950/90 border border-slate-800 px-3.5 py-1.5 rounded-xl">
      <div class="text-right">
        <div id="liveDateText" class="text-[11px] font-bold text-slate-300">--</div>
        <div id="liveClockText" class="text-sm font-black text-amber-400 tracking-wide">--:--:--</div>
      </div>
      <span id="netModeBadge" class="px-2 py-0.5 rounded-lg text-[10px] font-black bg-emerald-900 text-emerald-300">🌐 أونلاين</span>
    </div>

    <div class="flex items-center gap-2">
      <span id="gsPrintStatus" class="hidden sm:inline-block text-xs px-2.5 py-1 rounded-lg bg-slate-800 text-amber-400 font-bold">GS Print: جاري الفحص</span>
      <button onclick="logoutCashier()" class="text-xs px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-red-700 text-slate-200 font-bold">خروج</button>
    </div>
  </header>

  <!-- شريط تنبيه صوتي للأوردرات الجديدة -->
  <div id="alarmBanner" class="hidden bg-amber-400 text-slate-950 px-4 py-2 font-black flex items-center justify-between shadow-md z-10">
    <div class="flex items-center gap-3">
      <span class="text-2xl animate-bounce">🔔</span>
      <span id="alarmText" class="text-base">يوجد أوردر أونلاين جديد في انتظار القبول!</span>
    </div>
    <button onclick="switchTab('online')" class="bg-slate-900 text-white px-4 py-1.5 rounded-lg text-sm font-bold hover:bg-slate-800">
      عرض وقبول الآن
    </button>
  </div>

  <!-- المحتوى الرئيسي -->
  <main class="flex-1 overflow-hidden">

    <!-- 1. شاشة الكاشير (POS) -->
    <section id="tab-pos" class="tab-section h-full grid grid-cols-12 gap-3 p-3">
      <div class="col-span-12 lg:col-span-7 flex flex-col bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div id="posCategories" class="flex items-center gap-2 p-3 bg-slate-50 border-b border-slate-200 overflow-x-auto"></div>
        <div id="platformTicketBox" class="hidden px-3 py-2 bg-purple-50 border-b border-purple-200 flex items-center gap-2">
          <span class="text-xs font-black text-purple-900">🎫 رقم الشباك / الطلب:</span>
          <input type="text" id="platformTicketNumber" placeholder="اكتب رقم الشباك الخاص بالطلبات..." class="flex-1 p-1.5 text-sm font-black border border-purple-300 rounded-lg bg-white outline-none">
        </div>
        <div id="posItemsGrid" class="flex-1 p-3 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2.5 overflow-y-auto content-start"></div>
      </div>

      <div class="col-span-12 lg:col-span-5 flex flex-col bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div id="editingOrderBanner" class="hidden bg-amber-400 text-slate-950 px-3 py-2 flex items-center justify-between font-black text-xs">
          <span id="editingOrderText">✏️ وضع تعديل أوردر</span>
          <button onclick="cancelEditingMode()" class="bg-slate-900 text-white px-2.5 py-1 rounded-lg text-[11px]">إلغاء التعديل</button>
        </div>

        <div class="p-2.5 bg-slate-100 border-b border-slate-200 grid grid-cols-2 gap-2">
          <button onclick="setOrderType('takeaway')" id="btnTypeTakeaway" class="py-2 rounded-xl font-black text-sm bg-red-600 text-white shadow">
            🛍️ تيك أواي (استلام)
          </button>
          <button onclick="setOrderType('delivery')" id="btnTypeDelivery" class="py-2 rounded-xl font-black text-sm bg-white text-slate-700 border border-slate-300">
            🛵 دليفري (توصيل)
          </button>
        </div>

        <!-- اختيار طريقة الدفع: نقدي أو فيزا -->
        <div class="px-2.5 py-2 bg-slate-50 border-b border-slate-200 grid grid-cols-2 gap-2">
          <button type="button" onclick="setPaymentMethod('cash')" id="btnPayCash" class="py-1.5 rounded-xl font-black text-xs bg-emerald-600 text-white shadow">
            💵 دفع نقدي (كاش)
          </button>
          <button type="button" onclick="setPaymentMethod('visa')" id="btnPayVisa" class="py-1.5 rounded-xl font-black text-xs bg-white text-slate-700 border border-slate-300">
            💳 دفع فيزا (Visa)
          </button>
        </div>

        <div id="deliveryFormBox" class="hidden p-3 bg-amber-50/70 border-b border-amber-200 space-y-2 max-h-60 overflow-y-auto">
          <div id="blockedCustomerAlert" class="hidden bg-red-600 text-white text-xs font-black p-2 rounded-lg">
            ⚠️ تحذير: هذا العميل موقوف / محظور في قاعدة البيانات!
          </div>
          <div class="grid grid-cols-2 gap-2">
            <input type="tel" id="custPhone1" oninput="lookupCustomerByPhone(this.value)" placeholder="رقم التليفون الأساسي *" class="p-2 text-sm font-bold border border-slate-300 rounded-lg focus:border-red-600 outline-none bg-white">
            <input type="tel" id="custPhone2" placeholder="رقم تليفون احتياطي" class="p-2 text-sm font-bold border border-slate-300 rounded-lg focus:border-red-600 outline-none bg-white">
          </div>
          <div class="grid grid-cols-2 gap-2">
            <input type="text" id="custName" placeholder="اسم العميل *" class="p-2 text-sm font-bold border border-slate-300 rounded-lg focus:border-red-600 outline-none bg-white">
            <select id="custZone" onchange="recalcCart()" class="p-2 text-sm font-bold border border-slate-300 rounded-lg focus:border-red-600 outline-none bg-white">
              <option value="">-- اختر المنطقة --</option>
            </select>
          </div>
          <input type="text" id="custAddress" placeholder="العنوان بالتفصيل (الشارع / رقم العقار) *" class="w-full p-2 text-sm font-bold border border-slate-300 rounded-lg focus:border-red-600 outline-none bg-white">
          <div class="grid grid-cols-3 gap-2">
            <input type="text" id="custFloor" placeholder="الدور" class="p-2 text-sm font-bold border border-slate-300 rounded-lg outline-none bg-white">
            <input type="text" id="custApt" placeholder="الشقة" class="p-2 text-sm font-bold border border-slate-300 rounded-lg outline-none bg-white">
            <input type="text" id="custLandmark" placeholder="علامة مميزة" class="p-2 text-sm font-bold border border-slate-300 rounded-lg outline-none bg-white">
          </div>
          <div>
            <select id="custDriver" class="w-full p-2 text-sm font-black border border-blue-300 bg-blue-50 text-blue-900 rounded-lg outline-none">
              <option value="">-- اختر الطيار (الدليفري) أو اتركه للتعيين لاحقاً --</option>
            </select>
          </div>
        </div>

        <!-- السلة مع إضافة وحذف الملاحظات مباشرة من القائمة -->
        <div id="cartList" class="flex-1 p-3 overflow-y-auto divide-y divide-slate-100">
          <div class="text-center text-slate-400 py-10 font-bold">السلة فارغة.. اختر الأصناف من القائمة</div>
        </div>

        <div class="p-3 bg-slate-50 border-t border-slate-200 space-y-2">
          <input type="text" id="orderNotes" placeholder="ملاحظات عامة للفاتورة..." class="w-full p-2 text-xs font-bold border border-slate-300 rounded-lg bg-white">
          
          <div class="flex justify-between text-xs font-bold text-slate-600">
            <span>المجموع الفرعي: <b id="subTotalDisplay">0</b> ج.م</span>
            <span>خدمة التوصيل: <b id="deliveryFeeDisplay">0</b> ج.م</span>
          </div>
          <div class="flex justify-between items-center bg-slate-900 text-white p-2.5 rounded-xl">
            <span class="font-bold text-sm">الإجمالي (<span id="paymentMethodLabel" class="text-emerald-400">نقدي</span>):</span>
            <span class="text-2xl font-black text-amber-400"><span id="grandTotalDisplay">0</span> ج.م</span>
          </div>

          <div class="grid grid-cols-3 gap-2">
            <button onclick="clearCart()" class="col-span-1 bg-slate-200 hover:bg-slate-300 text-slate-800 font-black py-3 rounded-xl text-sm">
              مسح
            </button>
            <button onclick="submitPosOrder()" id="submitPosOrderBtn" class="col-span-2 bg-emerald-600 hover:bg-emerald-700 text-white font-black py-3 rounded-xl text-base shadow-lg">
              ✅ حفظ وطباعة (تحضير + فاتورة)
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- 1B. صفحة أوردرات التيك أواي والدليفري -->
    <section id="tab-ordersPage" class="tab-section hidden h-full p-4 overflow-y-auto">
      <div class="max-w-6xl mx-auto space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3 bg-white p-4 rounded-2xl shadow-sm border border-slate-200">
          <h2 class="text-xl font-black text-slate-800">📦 صفحة أوردرات التيك أواي والدليفري</h2>
          <div class="flex gap-2">
            <button onclick="setOrdersFilter('all')" id="filterOrd-all" class="px-3.5 py-1.5 rounded-xl text-xs font-black bg-slate-900 text-white">الكل</button>
            <button onclick="setOrdersFilter('takeaway')" id="filterOrd-takeaway" class="px-3.5 py-1.5 rounded-xl text-xs font-black bg-slate-100 text-slate-700">🛍️ تيك أواي</button>
            <button onclick="setOrdersFilter('delivery')" id="filterOrd-delivery" class="px-3.5 py-1.5 rounded-xl text-xs font-black bg-slate-100 text-slate-700">🛵 دليفري</button>
          </div>
        </div>
        <div id="ordersPageGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
      </div>
    </section>

    <!-- 2. شاشة طلبات الأونلاين -->
    <section id="tab-online" class="tab-section hidden h-full p-4 overflow-y-auto">
      <div class="max-w-6xl mx-auto">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-black text-slate-800">🔔 طلبات الأونلاين الواردة من رابط المنيو</h2>
          <button onclick="testBellSound()" class="bg-slate-800 text-white px-3 py-1.5 rounded-lg text-xs font-bold">🔊 اختبار صوت الجرس</button>
        </div>
        <div id="onlineOrdersGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
      </div>
    </section>

    <!-- 3. شاشة متابعة الدليفري وتعيين الطيارين -->
    <section id="tab-activeDelivery" class="tab-section hidden h-full p-4 overflow-y-auto">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-xl font-black text-slate-800 mb-4">🛵 أوردرات الدليفري النشطة (قيد التحضير / في الطريق)</h2>
        <div id="activeDeliveryGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
      </div>
    </section>

    <!-- 3B. صفحة تحصيل الطيارين -->
    <section id="tab-driverSettlement" class="tab-section hidden h-full p-4 overflow-y-auto">
      <div class="max-w-6xl mx-auto space-y-4">
        <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="text-xl font-black text-slate-800">💰 صفحة تحصيل الطيارين (خزنة الكاشير)</h2>
            <p class="text-xs text-slate-500 font-bold">عندما يسلّم الطيار الأوردر يظهر لك صوت تنبيه، ولا يدخل المبلغ الخزنة إلا بعد تحصيلك من الطيار (أوردر فردي أو تحصيل مجمع آخر اليوم)</p>
          </div>
          <div class="bg-emerald-50 border border-emerald-300 px-4 py-2 rounded-xl text-right">
            <div class="text-[11px] font-bold text-emerald-800">المحصل فعلياً في الخزنة اليوم</div>
            <div id="vaultConfirmedCashDisplay" class="text-lg font-black text-emerald-700">0 ج.م</div>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
          <div id="settlementDriversList" class="lg:col-span-4 space-y-2"></div>
          <div id="settlementDriverDetail" class="lg:col-span-8 bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
            <div class="text-center text-slate-400 font-bold py-12">اختر طياراً من القائمة لعرض أوردراته وتحصيلها</div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. شاشة إدارة الأصناف والأقسام والملاحظات الجاهزة -->
    <section id="tab-menuMgmt" class="tab-section hidden h-full p-4 overflow-y-auto">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="space-y-4">
          <!-- إضافة / تعديل قسم -->
