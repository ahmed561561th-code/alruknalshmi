    window.markOrderDelivered = async (orderId) => {
      await update(ref(db, `orders/${orderId}`), {
        status: 'completed',
        driverAccepted: true,
        settledInVault: false,
        completedAt: Date.now()
      });
      showToastModal('تم تسجيل تسليم الأوردر (يُحصّل في الخزنة من صفحة تحصيل الطيارين)', '✅');
    };

    window.selectSettlementDriver = (did) => {
      state.selectedSettlementDriverId = did;
      renderDriverSettlement();
    };

    function renderDriverSettlement() {
      const listEl = document.getElementById('settlementDriversList');
      const detailEl = document.getElementById('settlementDriverDetail');
      const vaultEl = document.getElementById('vaultConfirmedCashDisplay');
      if (!listEl || !detailEl) return;

      const validOrders = Object.entries(state.orders).filter(([_, o]) => o && o.status !== 'pending_online' && o.status !== 'rejected' && o.status !== 'cancelled');

      const vaultTotal = validOrders
        .filter(([_, o]) => o.type === 'takeaway' || o.settledInVault === true)
        .reduce((s, [_, o]) => s + Number(o.total || 0), 0);
      if (vaultEl) vaultEl.textContent = `${vaultTotal} ج.م`;

      const driverEntries = Object.entries(state.drivers || {});
      if (!state.selectedSettlementDriverId && driverEntries.length > 0) {
        state.selectedSettlementDriverId = driverEntries[0][0];
      }

      listEl.innerHTML = driverEntries.map(([did, d]) => {
        const dOrders = validOrders.filter(([_, o]) => o.driverId === did);
        const unsettled = dOrders.filter(([_, o]) => !o.settledInVault);
        const unsettledSum = unsettled.reduce((s, [_, o]) => s + Number(o.total || 0), 0);
        const hasDeliveredUnsettled = unsettled.some(([_, o]) => o.status === 'completed');
        const active = state.selectedSettlementDriverId === did;

        return `
          <button onclick="selectSettlementDriver('${did}')" class="w-full text-right p-3.5 rounded-2xl border transition ${active ? 'bg-slate-900 text-white border-slate-900 shadow' : 'bg-white text-slate-800 border-slate-200 hover:border-blue-500'}">
            <div class="flex justify-between items-center">
              <span class="font-black text-sm">🛵 ${d.name}</span>
              ${hasDeliveredUnsettled ? '<span class="bg-emerald-400 text-slate-950 text-[10px] font-black px-2 py-0.5 rounded-full">سلّم أوردر</span>' : ''}
            </div>
            <div class="flex justify-between items-center text-xs mt-1.5 ${active ? 'text-amber-300' : 'text-red-600'} font-black">
              <span>غير محصّل (${unsettled.length} أوردر):</span>
              <span>${unsettledSum} ج.م</span>
            </div>
          </button>
        `;
      }).join('') || '<div class="bg-white p-4 rounded-2xl text-xs font-bold text-slate-400">لا يوجد طيارون مسجلون</div>';

      const did = state.selectedSettlementDriverId;
      if (!did || !state.drivers[did]) {
        detailEl.innerHTML = '<div class="text-center text-slate-400 font-bold py-12">اختر طياراً لعرض تفاصيل تحصيله</div>';
        return;
      }

      const dInfo = state.drivers[did];
      const dOrders = validOrders.filter(([_, o]) => o.driverId === did).reverse();
      const unsettledOrders = dOrders.filter(([_, o]) => !o.settledInVault);
      const unsettledTotal = unsettledOrders.reduce((s, [_, o]) => s + Number(o.total || 0), 0);
      const settledTotal = dOrders.filter(([_, o]) => o.settledInVault).reduce((s, [_, o]) => s + Number(o.total || 0), 0);

      detailEl.innerHTML = `
        <div class="flex flex-wrap items-center justify-between gap-3 border-b pb-3 mb-4">
          <div>
            <h3 class="text-lg font-black text-slate-900">صفحة تحصيل الطيار: ${dInfo.name}</h3>
            <div class="text-xs font-bold text-slate-500">محصّل سابقاً في الخزنة: <b class="text-emerald-700">${settledTotal} ج.م</b> | مستحق الآن: <b class="text-red-600">${unsettledTotal} ج.م</b></div>
          </div>
          <div class="flex gap-2">
            <button onclick="settleSelectedDriverOrders('${did}')" ${unsettledOrders.length === 0 ? 'disabled' : ''} class="bg-emerald-600 hover:bg-emerald-700 disabled:opacity-40 text-white px-4 py-2.5 rounded-xl font-black text-xs shadow">
              💰 تحصيل المحددين / الكل معاً (${unsettledTotal} ج.م)
            </button>
          </div>
        </div>

        <div class="space-y-2">
          ${dOrders.map(([oid, o]) => `
            <div class="p-3 rounded-2xl border ${o.settledInVault ? 'bg-emerald-50/50 border-emerald-200' : (o.status === 'completed' ? 'bg-amber-50 border-amber-400' : 'bg-slate-50 border-slate-200')} flex flex-wrap items-center justify-between gap-2 text-xs font-bold">
              <div class="flex items-center gap-2.5">
                <input type="checkbox" class="settle-chk w-4 h-4 accent-emerald-600" data-order-id="${oid}" ${o.settledInVault ? 'disabled' : 'checked'}>
                <div>
                  <div class="font-black text-sm text-slate-900">#${o.orderNumber} — ${o.customer?.name || ''} (${o.customer?.zoneName || ''})</div>
                  <div class="text-[11px] text-slate-500">
                    ${o.status === 'completed' ? '<span class="text-emerald-800 font-black">✅ تم التسليم عند الزبون</span>' : '<span class="text-blue-700 font-black">🛵 في الطريق</span>'}
                    |
                    ${o.settledInVault ? '<span class="text-emerald-700 font-black">دخل الخزنة</span>' : '<span class="text-red-600 font-black">بانتظار التحصيل للخزنة</span>'}
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-sm font-black text-slate-900">${o.total} ج.م</span>
                ${!o.settledInVault ? `<button onclick="settleSingleDriverOrder('${oid}')" class="bg-blue-600 hover:bg-blue-700 text-white px-3 py-1.5 rounded-xl font-black text-xs">تحصيل الأوردر</button>` : ''}
              </div>
            </div>
          `).join('') || '<div class="text-center text-slate-400 py-8">لا توجد أوردرات لهذا الطيار اليوم</div>'}
        </div>
      `;
    }

    window.settleSingleDriverOrder = async (orderId) => {
      const o = state.orders[orderId];
      if (!o) return;
      await update(ref(db, `orders/${orderId}`), {
        settledInVault: true,
        settledAt: Date.now()
      });
      showToastModal(`تم تحصيل الأوردر #${o.orderNumber} (${o.total} ج.م) وإضافته للخزنة`, '💰');
    };

    window.settleSelectedDriverOrders = async (driverId) => {
      const checkboxes = Array.from(document.querySelectorAll('.settle-chk:checked:not(:disabled)'));
      const ids = checkboxes.map(cb => cb.getAttribute('data-order-id')).filter(Boolean);
      if (ids.length === 0) return showToastModal('لا توجد أوردرات محددة للتحصيل!', '⚠️');

      let totalCollected = 0;
      for (const oid of ids) {
        const o = state.orders[oid];
        if (o) {
          totalCollected += Number(o.total || 0);
          await update(ref(db, `orders/${oid}`), {
            settledInVault: true,
            settledAt: Date.now()
          });
        }
      }
      const dName = state.drivers[driverId]?.name || 'الطيار';
      showToastModal(`تم تحصيل (${ids.length}) أوردر من ${dName} بإجمالي (${totalCollected} ج.م) وإضافتها للخزنة`, '💰');
    };

    window.startEditCategory = (id) => {
      const cat = state.categories[id];
      if (!cat) return;
      state.editingCategoryId = id;
      document.getElementById('catFormTitle').textContent = `✏️ تعديل القسم: ${cat.name}`;
      document.getElementById('newCatName').value = cat.name || '';
      document.getElementById('newCatHiddenOnMenu').checked = !!cat.hiddenOnMenu;
      document.getElementById('newCatIsPlatform').checked = !!cat.isPlatform;
      document.getElementById('saveCatBtn').textContent = 'حفظ التعديل';
      document.getElementById('cancelEditCatBtn').classList.remove('hidden');
      document.getElementById('newCatName').focus();
    };

    window.cancelEditCategory = () => {
      state.editingCategoryId = null;
      document.getElementById('catFormTitle').textContent = '➕ إضافة قسم جديد';
      document.getElementById('newCatName').value = '';
      document.getElementById('newCatHiddenOnMenu').checked = false;
      document.getElementById('newCatIsPlatform').checked = false;
      document.getElementById('saveCatBtn').textContent = 'إضافة';
      document.getElementById('cancelEditCatBtn').classList.add('hidden');
    };

    window.saveCategory = async () => {
      const name = document.getElementById('newCatName').value.trim();
      if (!name) return;
      const hiddenOnMenu = document.getElementById('newCatHiddenOnMenu').checked;
      const isPlatform = document.getElementById('newCatIsPlatform').checked;

      if (state.editingCategoryId) {
        const targetId = state.editingCategoryId;
        state.categories[targetId] = { ...state.categories[targetId], name, hiddenOnMenu, isPlatform };
        persistLocalSnapshot();
        renderCategories();
        try { await update(ref(db, `categories/${targetId}`), { name, hiddenOnMenu, isPlatform }); } catch (e) {}
        cancelEditCategory();
        showToastModal(`تم تحديث القسم "${name}" بنجاح`, '✏️');
      } else {
        const tempId = `cat_${Date.now()}`;
        state.categories[tempId] = { name, hiddenOnMenu, isPlatform };
        persistLocalSnapshot();
        renderCategories();
        try {
          const newRef = await push(ref(db, 'categories'), { name, hiddenOnMenu, isPlatform });
          delete state.categories[tempId];
          state.categories[newRef.key] = { name, hiddenOnMenu, isPlatform };
          persistLocalSnapshot();
        } catch (e) {}
        cancelEditCategory();
        showToastModal(`تم إضافة القسم "${name}"`, '✅');
      }
    };

    window.addCategory = () => window.saveCategory();

    window.toggleCategoryMenuVisibility = async (id, currentlyHidden) => {
      state.categories[id].hiddenOnMenu = !currentlyHidden;
      persistLocalSnapshot();
      renderCategories();
      try { await update(ref(db, `categories/${id}`), { hiddenOnMenu: !currentlyHidden }); } catch (e) {}
      showToastModal(!currentlyHidden ? 'تم إخفاء القسم عن منيو الزبون' : 'تم إظهار القسم في منيو الزبون', '👁️');
    };

    window.deleteCategory = async (id) => {
      if (confirm('حذف هذا القسم؟')) {
        if (state.editingCategoryId === id) cancelEditCategory();
        delete state.categories[id];
        persistLocalSnapshot();
        renderCategories();
        try { await remove(ref(db, `categories/${id}`)); } catch (e) {}
        showToastModal('تم حذف القسم', '🗑️');
      }
    };

    window.startEditMenuItem = (id) => {
      const item = state.items[id];
      if (!item) return;
      state.editingItemId = id;
      document.getElementById('itemFormTitle').textContent = `✏️ تعديل الصنف: ${item.name}`;
      document.getElementById('newItemCat').value = item.categoryId || '';
      document.getElementById('newItemName').value = item.name || '';
      document.getElementById('newItemPrice').value = item.price ?? '';
      document.getElementById('newItemDesc').value = item.desc || '';
      document.getElementById('newItemImg').value = item.img || '';
      document.getElementById('saveItemBtn').textContent = 'حفظ تعديل الصنف';
      document.getElementById('cancelEditItemBtn').classList.remove('hidden');
      document.getElementById('newItemName').focus();
    };

    window.cancelEditMenuItem = () => {
      state.editingItemId = null;
      document.getElementById('itemFormTitle').textContent = '🍔 إضافة صنف جديد للمنيو';
      ['newItemName','newItemPrice','newItemDesc','newItemImg'].forEach(i => document.getElementById(i).value = '');
      document.getElementById('saveItemBtn').textContent = 'حفظ الصنف';
      document.getElementById('cancelEditItemBtn').classList.add('hidden');
    };

    window.saveMenuItem = async () => {
      const categoryId = document.getElementById('newItemCat').value;
      const name = document.getElementById('newItemName').value.trim();
      const price = Number(document.getElementById('newItemPrice').value);
      const desc = document.getElementById('newItemDesc').value.trim();
      const img = document.getElementById('newItemImg').value.trim();
      if (!categoryId || !name || !price) return showToastModal('اختر القسم واكتب اسم الصنف والسعر!', '⚠️');

      if (state.editingItemId) {
        const targetId = state.editingItemId;
        state.items[targetId] = { ...state.items[targetId], categoryId, name, price, desc, img };
        persistLocalSnapshot();
        renderPosItems();
        renderItemsMgmtTable();
        try { await update(ref(db, `items/${targetId}`), { categoryId, name, price, desc, img }); } catch (e) {}
        cancelEditMenuItem();
        showToastModal(`تم تعديل الصنف "${name}" بنجاح`, '✏️');
      } else {
        const tempId = `item_${Date.now()}`;
        const itemData = { categoryId, name, price, desc, img, disabledDate: null };
        state.items[tempId] = itemData;
        persistLocalSnapshot();
        renderPosItems();
        renderItemsMgmtTable();
        try {
          const newRef = await push(ref(db, 'items'), itemData);
          delete state.items[tempId];
          state.items[newRef.key] = itemData;
          persistLocalSnapshot();
        } catch (e) {}
        cancelEditMenuItem();
        showToastModal(`تم إضافة الصنف "${name}"`, '🍔');
      }
    };

    window.addMenuItem = () => window.saveMenuItem();

    window.toggleItemToday = async (id, currentlyStopped) => {
      const nextDisabled = currentlyStopped ? null : todayStr();
      state.items[id].disabledDate = nextDisabled;
      persistLocalSnapshot();
      renderPosItems();
      renderItemsMgmtTable();
      try {
        await update(ref(db, `items/${id}`), { disabledDate: nextDisabled });
      } catch (e) {}
      showToastModal(currentlyStopped ? 'تم إعادة تشغيل الصنف في المنيو' : 'تم إيقاف الصنف لآخر اليوم في المنيو', '📋');
    };

    window.deleteMenuItem = async (id) => {
      if (confirm('حذف الصنف نهائياً؟')) {
        if (state.editingItemId === id) cancelEditMenuItem();
        delete state.items[id];
        persistLocalSnapshot();
        renderPosItems();
        renderItemsMgmtTable();
        try { await remove(ref(db, `items/${id}`)); } catch (e) {}
        showToastModal('تم حذف الصنف', '🗑️');
      }
    };

    function renderItemsMgmtTable() {
      const tbody = document.getElementById('itemsTableBody');
      if (!tbody) return;
      const today = todayStr();
      tbody.innerHTML = Object.entries(state.items || {}).map(([id, item]) => {
        if (!item) return '';
        const isStopped = item.disabledDate === today;
        const catName = state.categories[item.categoryId]?.name || '-';
        return `
          <tr>
            <td class="p-2.5">${item.name}</td>
            <td class="p-2.5 text-slate-500">${catName}</td>
            <td class="p-2.5 text-red-600">${item.price} ج.م</td>
            <td class="p-2.5">
              <button onclick="toggleItemToday('${id}', ${isStopped})" class="px-3 py-1 rounded-lg text-xs font-black ${isStopped ? 'bg-red-100 text-red-700' : 'bg-emerald-100 text-emerald-700'}">
                ${isStopped ? '⛔ غير موجود حاليًا (تشغيل)' : '✅ متاح (إيقاف لآخر اليوم)'}
              </button>
            </td>
            <td class="p-2.5 space-x-2 space-x-reverse">
              <button type="button" onclick="startEditMenuItem('${id}')" class="bg-amber-100 hover:bg-amber-200 text-amber-950 px-2.5 py-1 rounded-lg text-xs font-black">✏️ تعديل</button>
              <button type="button" onclick="deleteMenuItem('${id}')" class="text-red-600 hover:underline text-xs font-black">حذف</button>
            </td>
          </tr>
        `;
      }).join('');
    }

    window.addZone = async () => {
      const name = document.getElementById('newZoneName').value.trim();
      const fee = Number(document.getElementById('newZoneFee').value);
      if (!name || isNaN(fee)) return showToastModal('اكتب اسم المنطقة وسعر التوصيل!', '⚠️');
      const tempId = `zone_${Date.now()}`;
      state.zones[tempId] = { name, fee };
      persistLocalSnapshot();
      renderZones();
      try {
        const newRef = await push(ref(db, 'zones'), { name, fee });
        delete state.zones[tempId];
        state.zones[newRef.key] = { name, fee };
        persistLocalSnapshot();
      } catch (e) {}
      document.getElementById('newZoneName').value = '';
      document.getElementById('newZoneFee').value = '';
      showToastModal(`تم إضافة منطقة "${name}"`, '🗺️');
    };

    window.deleteZone = async (id) => {
      if (confirm('حذف المنطقة؟')) {
        delete state.zones[id];
        persistLocalSnapshot();
        renderZones();
        try { await remove(ref(db, `zones/${id}`)); } catch (e) {}
      }
    };

    function renderZones() {
      const select = document.getElementById('custZone');
      const list = document.getElementById('zonesList');
      if (!select || !list) return;
      let optHtml = '<option value="">-- اختر المنطقة --</option>';
      let listHtml = '';

      Object.entries(state.zones || {}).forEach(([id, z]) => {
        if (!z) return;
        optHtml += `<option value="${id}">${z.name} (${z.fee} ج.م)</option>`;
        listHtml += `
          <div class="py-2.5 flex justify-between items-center font-bold text-sm">
            <span>${z.name} — <b class="text-red-600">${z.fee} ج.م</b></span>
            <button onclick="deleteZone('${id}')" class="text-red-600 text-xs">حذف</button>
          </div>
        `;
      });
      select.innerHTML = optHtml;
      list.innerHTML = listHtml;
