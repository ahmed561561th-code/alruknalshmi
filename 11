          <table style="width:100%; border-collapse:collapse; font-family:'Tajawal',sans-serif;">
            <thead>
              <tr style="border-bottom:1px dashed #000; font-size:13px; font-weight:900;">
                <th style="text-align:right; padding:4px 2px;">الصنف</th>
                <th style="text-align:center; padding:4px 2px;">العدد</th>
