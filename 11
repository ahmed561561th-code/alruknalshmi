    function printViaHiddenIframe(htmlContent) {
      return new Promise((resolve) => {
        const frame = document.getElementById('silentPrintFrame');
        if (!frame) {
          const printArea = document.getElementById('printArea');
          printArea.innerHTML = htmlContent;
          printArea.classList.remove('hidden');
          window.print();
          printArea.classList.add('hidden');
          return resolve();
        }
        const doc = frame.contentWindow.document;
        doc.open();
        doc.write(`
          <!DOCTYPE html>
          <html lang="ar" dir="rtl">
          <head>
            <meta charset="UTF-8" />
            <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@700;800;900&display=swap" rel="stylesheet">
            <style>
              * { font-family: 'Tajawal', sans-serif !important; box-sizing: border-box; }
              body { margin: 0; padding: 0; width: 78mm; color: #000; }
              @page { size: 80mm auto; margin: 1.5mm; }
            </style>
          </head>
          <body>${htmlContent}</body>
          </html>
        `);
        doc.close();
        setTimeout(() => {
          try {
            frame.contentWindow.focus();
            frame.contentWindow.print();
          } catch (e) {
            window.print();
          }
          setTimeout(resolve, 350);
        }, 250);
      });
    }

    async function printSingleTicket(htmlContent, printerName) {
      const gsPrintUrl = localStorage.getItem('gsPrintUrl') || DEFAULT_GS_PRINT_URL;
      if (gsPrintUrl) {
        try {
          const controller = new AbortController();
          const tid = setTimeout(() => controller.abort(), 2500);
          const res = await fetch(gsPrintUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            signal: controller.signal,
            body: JSON.stringify({
              printer: printerName || '',
              widthMm: 80,
              format: 'html',
              content: htmlContent
            })
          });
          clearTimeout(tid);
          if (res && res.ok) {
            gsPrintConnected = true;
            return;
          }
        } catch (err) {
          // في حالة عدم تشغيل GS Print Manager يتم التحويل للطباعة المباشرة تلقائياً
        }
      }

      await printViaHiddenIframe(htmlContent);
    }

    async function triggerSeparatedPrint(order) {
      const kitchenPrinter = localStorage.getItem('kitchenPrinter');
      const cashierPrinter = localStorage.getItem('cashierPrinter');
      const kitchenHtml = buildKitchenTicketHTML(order);
      const cashierHtml = buildCashierInvoiceHTML(order);

      await printSingleTicket(kitchenHtml, kitchenPrinter);
      await printSingleTicket(cashierHtml, cashierPrinter);
    }

    window.printCategoryItemsReport = async () => {
      const grouped = buildGroupedCategorySales();
      let grandTotal = 0;
      const sectionsHtml = Object.entries(grouped).map(([catName, g]) => {
        grandTotal += g.catTotalRevenue;
        const rows = Object.entries(g.items).map(([iName, info]) => `
          <tr style="border-bottom:1px dotted #666;">
