      const password = document.getElementById('newDriverPass').value.trim() || String(Math.floor(1000 + Math.random() * 9000));

      const driverObj = { name, phone, username, password };
      const tempId = `drv_${Date.now()}`;
      state.drivers[tempId] = driverObj;
      persistLocalSnapshot();
      renderDrivers();
      try {
        const newRef = await push(ref(db, 'drivers'), driverObj);
        delete state.drivers[tempId];
        state.drivers[newRef.key] = driverObj;
        persistLocalSnapshot();
      } catch (e) {}

      const box = document.getElementById('lastCreatedDriverBox');
      box.classList.remove('hidden');
      box.innerHTML = `
        <div>✅ تم إضافة الطيار: <b>${name}</b></div>
        <div>🔑 اليوزر نيم: <span class="bg-white px-2 py-0.5 rounded border">${username}</span> | الباسورد: <span class="bg-white px-2 py-0.5 rounded border">${password}</span></div>
      `;

      ['newDriverName','newDriverPhone','newDriverUser','newDriverPass'].forEach(i => document.getElementById(i).value = '');
      showToastModal(`تم إنشاء حساب الطيار (${name}) — اليوزر: ${username} | الباسورد: ${password}`, '🛵');
    };

    window.deleteDriver = async (id) => {
