    window.checkGsPrintManager = async (manualClick = false) => {
      const statusEl = document.getElementById('gsPrintStatus');
      const box = document.getElementById('detectedPrintersList');
      const baseUrl = (localStorage.getItem('gsPrintUrl') || DEFAULT_GS_PRINT_URL).replace(/\/print\/?$/, '');
      try {
        const controller = new AbortController();
        const tid = setTimeout(() => controller.abort(), 2000);
        const res = await fetch(`${baseUrl}/status`, { method: 'GET', signal: controller.signal }).catch(() => null);
        clearTimeout(tid);
        if (res && res.ok) {
          gsPrintConnected = true;
          if (statusEl) {
            statusEl.textContent = 'GS Print: متصل ✅';
            statusEl.className = 'hidden sm:inline-block text-xs px-2.5 py-1 rounded-lg bg-emerald-900 text-emerald-300 font-bold';
          }
          const data = await res.json().catch(() => null);
          if (manualClick && box) {
            box.classList.remove('hidden');
            const pList = Array.isArray(data?.printers) ? data.printers.join(' | ') : 'متصل وجاهز للطباعة الصامتة';
            box.innerHTML = `<b>حالة GS Print Manager:</b> متصل ✅<br>${pList}`;
          }
          return true;
