              ${isStopped ? '<span class="text-[10px] bg-red-100 text-red-700 px-1.5 py-0.5 rounded font-black">غير موجود حاليًا</span>' : '<span class="bg-slate-100 text-slate-600 text-xs px-2 py-0.5 rounded-lg font-black">+</span>'}
            </div>
          </button>
        `;
      });

      grid.innerHTML = html || '<div class="col-span-full text-center text-slate-400 py-10 font-bold">لا توجد أصناف في هذا القسم</div>';
    }

    window.addToCart = (itemId) => {
      const item = state.items[itemId];
      if (!item) return;
      const existing = state.cart.find(c => c.id === itemId && !c.notes);
      if (existing) existing.qty += 1;
      else state.cart.push({ id: itemId, name: item.name, categoryId: item.categoryId || '', price: Number(item.price), qty: 1, notes: '' });
      recalcCart();
    };

    window.changeQty = (idx, delta) => {
      state.cart[idx].qty += delta;
      if (state.cart[idx].qty <= 0) state.cart.splice(idx, 1);
      recalcCart();
    };

    window.removeCartItem = (idx) => {
      state.cart.splice(idx, 1);
      recalcCart();
    };

    window.updateCartItemNoteDirect = (idx, val) => {
      if (!state.cart[idx]) return;
      state.cart[idx].notes = val;
    };

    window.clearCartItemNoteDirect = (idx) => {
      if (!state.cart[idx]) return;
      state.cart[idx].notes = '';
      recalcCart();
    };

    window.openItemNotesModal = (idx) => {
      state.editingNoteIndex = idx;
      const item = state.cart[idx];
      document.getElementById('noteModalItemName').textContent = item.name;
      document.getElementById('activeItemNoteInput').value = item.notes || '';
      renderPresetNotesChips();
      document.getElementById('itemNotesModal').classList.remove('hidden');
    };

    window.closeItemNotesModal = () => {
      document.getElementById('itemNotesModal').classList.add('hidden');
      state.editingNoteIndex = null;
    };

    function renderPresetNotesChips() {
      const chips = document.getElementById('presetNotesChips');
      if (!chips) return;
      chips.innerHTML = (state.presetNotes || []).map(n => `
        <button type="button" onclick="pickPresetNote('${n.replace(/'/g, "\\'")}')" class="bg-amber-100 hover:bg-amber-200 text-amber-950 px-3 py-1.5 rounded-xl text-xs font-black border border-amber-300">
          + ${n}
        </button>
      `).join('');
    }

    window.pickPresetNote = (noteText) => {
      const inp = document.getElementById('activeItemNoteInput');
      const current = inp.value.trim();
      if (!current) inp.value = noteText;
      else if (!current.includes(noteText)) inp.value = `${current} - ${noteText}`;
    };

    window.addPresetNote = async () => {
      const txt = document.getElementById('newPresetNoteInput').value.trim();
      if (!txt) return;
      if (!state.presetNotes.includes(txt)) {
        state.presetNotes.push(txt);
        persistLocalSnapshot();
        try { await set(ref(db, 'presetNotes'), state.presetNotes); } catch (e) {}
      }
      document.getElementById('newPresetNoteInput').value = '';
      pickPresetNote(txt);
      renderPresetNotesChips();
      renderMgmtNotesList();
    };

    window.saveItemNoteFromModal = () => {
      if (state.editingNoteIndex === null) return;
      state.cart[state.editingNoteIndex].notes = document.getElementById('activeItemNoteInput').value.trim();
      closeItemNotesModal();
      recalcCart();
    };

    window.clearItemNoteFromModal = () => {
      if (state.editingNoteIndex === null) return;
      state.cart[state.editingNoteIndex].notes = '';
      closeItemNotesModal();
      recalcCart();
    };

    window.clearCart = () => {
      state.cart = [];
      document.getElementById('orderNotes').value = '';
      document.getElementById('platformTicketNumber').value = '';
      recalcCart();
    };

    window.recalcCart = () => {
      const list = document.getElementById('cartList');
      if (state.cart.length === 0) {
        list.innerHTML = '<div class="text-center text-slate-400 py-10 font-bold">السلة فارغة.. اختر الأصناف من القائمة</div>';
      } else {
        list.innerHTML = state.cart.map((c, idx) => `
          <div class="py-2.5 space-y-1.5">
            <div class="flex items-center justify-between gap-2">
              <div class="flex-1">
                <div class="font-black text-sm text-slate-800">${c.name}</div>
                <div class="text-xs text-slate-500 font-bold">${c.price} × ${c.qty} = ${c.price * c.qty} ج.م</div>
              </div>
              <button type="button" onclick="openItemNotesModal(${idx})" class="px-2 py-1.5 rounded-lg bg-amber-100 hover:bg-amber-200 text-amber-900 font-black text-xs">
                📝 جاهزة
              </button>
              <div class="flex items-center gap-1">
                <button onclick="changeQty(${idx}, -1)" class="w-7 h-7 rounded-lg bg-slate-200 font-black text-slate-800">-</button>
                <span class="w-6 text-center font-black text-sm">${c.qty}</span>
                <button onclick="changeQty(${idx}, 1)" class="w-7 h-7 rounded-lg bg-red-600 text-white font-black">+</button>
                <button onclick="removeCartItem(${idx})" class="w-7 h-7 rounded-lg bg-red-100 text-red-700 font-black text-xs">✕</button>
              </div>
            </div>
            <div class="flex items-center gap-1.5">
              <input type="text" value="${c.notes || ''}" oninput="updateCartItemNoteDirect(${idx}, this.value)" placeholder="إضافة ملاحظة للصنف (مثال: حار، بدون عيش)..." class="flex-1 px-2.5 py-1 text-xs font-bold border border-amber-300 bg-amber-50/60 rounded-lg outline-none focus:border-amber-500">
              ${c.notes ? `<button type="button" onclick="clearCartItemNoteDirect(${idx})" class="px-2 py-1 rounded-lg bg-red-100 hover:bg-red-200 text-red-700 font-black text-xs" title="حذف الملاحظة">حذف</button>` : ''}
            </div>
          </div>
        `).join('');
      }

      const subTotal = state.cart.reduce((s, c) => s + (c.price * c.qty), 0);
      let deliveryFee = 0;
      if (state.orderType === 'delivery') {
        const zoneId = document.getElementById('custZone').value;
        if (zoneId && state.zones[zoneId]) deliveryFee = Number(state.zones[zoneId].fee || 0);
      }

      document.getElementById('subTotalDisplay').textContent = subTotal;
      document.getElementById('deliveryFeeDisplay').textContent = deliveryFee;
      document.getElementById('grandTotalDisplay').textContent = subTotal + deliveryFee;
    };

    window.submitPosOrder = async () => {
      if (state.cart.length === 0) return showToastModal('اختر صنفاً واحداً على الأقل!', '⚠️');

      let customerData = null;
      let driverId = '';
      let driverName = '';
      let deliveryFee = 0;
      const platformTicket = document.getElementById('platformTicketNumber').value.trim();

      if (state.orderType === 'delivery') {
        const phone1 = document.getElementById('custPhone1').value.trim();
        const name = document.getElementById('custName').value.trim();
        const zoneId = document.getElementById('custZone').value;
        const address = document.getElementById('custAddress').value.trim();
        if (!phone1 || !name || !zoneId || !address) {
          return showToastModal('يرجى إدخال: التليفون الأساسي، الاسم، المنطقة، والعنوان!', '⚠️');
        }
        const zoneObj = state.zones[zoneId] || { name: '', fee: 0 };
        deliveryFee = Number(zoneObj.fee || 0);
        driverId = document.getElementById('custDriver').value;
        driverName = driverId && state.drivers[driverId] ? state.drivers[driverId].name : '';

        customerData = {
          phone1,
          phone2: document.getElementById('custPhone2').value.trim(),
          name,
          zoneId,
          zoneName: zoneObj.name,
          address,
          floor: document.getElementById('custFloor').value.trim(),
          apt: document.getElementById('custApt').value.trim(),
          landmark: document.getElementById('custLandmark').value.trim()
        };

        const existingEntry = Object.entries(state.customers).find(([k, c]) => k === phone1 || c.phone1 === phone1 || c.phone === phone1);
        if (existingEntry) {
          state.customers[existingEntry[0]] = { ...existingEntry[1], ...customerData, ordersCount: (existingEntry[1].ordersCount || 0) + 1 };
          try { await update(ref(db, `customers/${existingEntry[0]}`), state.customers[existingEntry[0]]); } catch (e) {}
        } else {
          state.customers[phone1] = { ...customerData, ordersCount: 1, blocked: false };
          try { await set(ref(db, `customers/${phone1}`), state.customers[phone1]); } catch (e) {}
        }
        persistLocalSnapshot();
      }

      const subTotal = state.cart.reduce((s, c) => s + (c.price * c.qty), 0);

      if (state.editingOrderId) {
        const prevOrder = state.orders[state.editingOrderId] || {};
        const updatedOrder = {
          ...prevOrder,
          type: state.orderType,
          paymentMethod: state.paymentMethod,
          platformTicket,
          items: state.cart,
          notes: document.getElementById('orderNotes').value.trim(),
          subTotal,
          deliveryFee,
          total: subTotal + deliveryFee,
          customer: customerData,
          driverId,
          driverName,
          status: state.orderType === 'takeaway' ? 'completed' : (driverId ? 'out_for_delivery' : 'preparing'),
          updatedAt: Date.now()
        };
        state.orders[state.editingOrderId] = updatedOrder;
        recordOrderInMonthLedger({ id: state.editingOrderId, ...updatedOrder });
        persistLocalSnapshot();
        try { await update(ref(db, `orders/${state.editingOrderId}`), updatedOrder); } catch (e) {}
        await triggerSeparatedPrint({ id: state.editingOrderId, ...updatedOrder });
        cancelEditingMode();
        if (state.orderType === 'delivery') {
          ['custPhone1','custPhone2','custName','custAddress','custFloor','custApt','custLandmark'].forEach(id => document.getElementById(id).value = '');
          document.getElementById('custZone').value = '';
          document.getElementById('custDriver').value = '';
        }
        showToastModal(`تم حفظ التعديلات على الأوردر #${updatedOrder.orderNumber} وإعادة الطباعة`, '✅');
        return;
      }

      const assignedNum = Number(state.orderCounter || 1);
      const nextCounterVal = assignedNum + 1;

      const orderObj = {
        orderNumber: assignedNum,
        date: todayStr(),
        type: state.orderType,
        paymentMethod: state.paymentMethod,
        source: state.editingOnlineOrderId ? 'online' : 'pos',
        platformTicket,
        items: state.cart,
        notes: document.getElementById('orderNotes').value.trim(),
        subTotal,
        deliveryFee,
        total: subTotal + deliveryFee,
        customer: customerData,
        driverId,
        driverName,
        driverAccepted: !driverId,
        settledInVault: state.orderType === 'takeaway',
        status: state.orderType === 'takeaway' ? 'completed' : (driverId ? 'out_for_delivery' : 'preparing'),
        createdAt: Date.now()
      };

      const localTempId = `local_${Date.now()}`;
      state.orders[localTempId] = orderObj;
      state.orderCounter = nextCounterVal;
      document.getElementById('nextOrderBadge').textContent = `#${nextCounterVal}`;
      recordOrderInMonthLedger({ id: localTempId, ...orderObj });
      persistLocalSnapshot();
      renderOrdersPage();
      renderReports();

      if (navigator.onLine) {
        try {
          const counterRef = ref(db, 'meta/dailyCounter');
          await runTransaction(counterRef, (curr) => {
            return (curr || assignedNum) + 1;
          });
          const newOrderRef = await push(ref(db, 'orders'), orderObj);
          delete state.orders[localTempId];
          state.orders[newOrderRef.key] = orderObj;
          recordOrderInMonthLedger({ id: newOrderRef.key, ...orderObj });
          if (state.editingOnlineOrderId) {
            await remove(ref(db, `orders/${state.editingOnlineOrderId}`));
          }
          persistLocalSnapshot();
        } catch (e) {}
      }

      await triggerSeparatedPrint({ id: localTempId, ...orderObj });

      cancelEditingMode();
      if (state.orderType === 'delivery') {
        ['custPhone1','custPhone2','custName','custAddress','custFloor','custApt','custLandmark'].forEach(id => document.getElementById(id).value = '');
        document.getElementById('custZone').value = '';
        document.getElementById('custDriver').value = '';
      }
      showToastModal(`تم حفظ وطباعة الأوردر #${assignedNum} بنجاح`, '✅');
    };

    window.setOrdersFilter = (flt) => {
      state.ordersFilter = flt;
      ['all', 'takeaway', 'delivery'].forEach(k => {
        const b = document.getElementById(`filterOrd-${k}`);
        b.className = k === flt
          ? 'px-3.5 py-1.5 rounded-xl text-xs font-black bg-slate-900 text-white'
          : 'px-3.5 py-1.5 rounded-xl text-xs font-black bg-slate-100 text-slate-700';
      });
      renderOrdersPage();
    };

    function renderOrdersPage() {
      const grid = document.getElementById('ordersPageGrid');
      if (!grid) return;
      const list = Object.entries(state.orders)
        .filter(([_, o]) => o && o.status !== 'pending_online' && o.status !== 'rejected')
        .filter(([_, o]) => state.ordersFilter === 'all' || o.type === state.ordersFilter)
        .reverse();

      if (list.length === 0) {
        grid.innerHTML = '<div class="col-span-full bg-white p-10 rounded-2xl text-center font-bold text-slate-400">لا توجد أوردرات مطابقة حالياً</div>';
        return;
      }

      grid.innerHTML = list.map(([id, o]) => {
        const isCancelled = o.status === 'cancelled';
        return `
          <div class="bg-white border ${isCancelled ? 'border-red-300 opacity-75' : 'border-slate-200'} rounded-2xl p-4 shadow-sm space-y-3">
            <div class="flex justify-between items-center border-b pb-2">
              <span class="bg-slate-900 text-amber-400 font-black px-3 py-1 rounded-lg text-base">#${o.orderNumber}</span>
              <div class="flex items-center gap-1.5">
                <span class="px-2 py-0.5 rounded-lg text-[11px] font-black ${o.paymentMethod === 'visa' ? 'bg-indigo-100 text-indigo-800' : 'bg-emerald-100 text-emerald-800'}">
                  ${o.paymentMethod === 'visa' ? '💳 فيزا' : '💵 نقدي'}
                </span>
                <span class="px-2.5 py-1 rounded-lg text-xs font-black ${isCancelled ? 'bg-red-100 text-red-700' : (o.type === 'delivery' ? 'bg-amber-100 text-amber-900' : 'bg-blue-100 text-blue-900')}">
                  ${isCancelled ? '🗑️ ملغي' : (o.type === 'delivery' ? '🛵 دليفري' : '🛍️ تيك أواي')}
                </span>
              </div>
            </div>
            ${o.customer ? `<div class="text-xs font-bold text-slate-700">👤 <b>${o.customer.name}</b> (${o.customer.phone1}) — ${o.customer.zoneName || ''}</div>` : ''}
            <div class="bg-slate-50 p-2.5 rounded-xl text-xs font-bold space-y-1">
              ${(o.items || []).map(i => `<div class="flex justify-between"><span>${i.qty} × ${i.name} ${i.notes ? `<b class="text-amber-700">(${i.notes})</b>` : ''}</span><span>${i.qty * i.price} ج.م</span></div>`).join('')}
            </div>
            <div class="flex justify-between items-center font-black text-base">
              <span>الإجمالي:</span>
              <span class="text-red-600">${o.total} ج.م</span>
            </div>
            <div class="grid grid-cols-2 gap-1.5">
              <button onclick='reprintKitchenOnlyById("${id}")' class="bg-orange-500 hover:bg-orange-600 text-white py-2 rounded-xl font-black text-xs shadow">
                👨‍🍳 طباعة بون تحضير
              </button>
              <button onclick='reprintOrderById("${id}")' class="bg-slate-800 hover:bg-slate-900 text-white py-2 rounded-xl font-black text-xs">
                🖨️ طباعة الكل
              </button>
              <button onclick="loadOrderIntoPosForEdit('${id}', false)" ${isCancelled ? 'disabled' : ''} class="bg-amber-500 hover:bg-amber-600 disabled:opacity-40 text-slate-950 py-2 rounded-xl font-black text-xs shadow">
                ✏️ تعديل
              </button>
              <button onclick="openCancelOrderModal('${id}')" ${isCancelled ? 'disabled' : ''} class="bg-red-600 hover:bg-red-700 disabled:opacity-40 text-white py-2 rounded-xl font-black text-xs">
                🗑️ إلغاء
              </button>
            </div>
          </div>
        `;
      }).join('');
    }

    function renderOnlineOrders() {
      const grid = document.getElementById('onlineOrdersGrid');
      if (!grid) return;
      const list = Object.entries(state.orders).filter(([_, o]) => o && o.status === 'pending_online');
      if (list.length === 0) {
        grid.innerHTML = '<div class="col-span-full bg-white p-10 rounded-2xl text-center font-bold text-slate-400">لا توجد طلبات أونلاين معلقة حالياً</div>';
        return;
      }

      grid.innerHTML = list.map(([id, o]) => `
        <div class="bg-white border-2 border-amber-400 rounded-2xl p-4 shadow-md space-y-3">
          <div class="flex justify-between items-center border-b pb-2">
            <span class="bg-amber-400 text-slate-950 font-black px-2.5 py-1 rounded-lg text-sm">طلب أونلاين جديد</span>
            <span class="text-xs font-bold text-slate-500">${new Date(o.createdAt).toLocaleTimeString('ar-EG')}</span>
          </div>
          <div class="text-sm font-bold text-slate-800 space-y-1">
            <div>👤 <b>${o.customer?.name}</b> (${o.customer?.phone1})</div>
            ${o.customer?.phone2 ? `<div>📞 احتياطي: ${o.customer.phone2}</div>` : ''}
            <div>📍 <b>${o.customer?.zoneName}</b> - ${o.customer?.address}</div>
            <div class="text-xs text-slate-600">الدور: ${o.customer?.floor || '-'} | الشقة: ${o.customer?.apt || '-'} | علامة: ${o.customer?.landmark || '-'}</div>
          </div>
          <div class="bg-slate-50 p-2.5 rounded-xl text-xs font-bold space-y-1">
            ${(o.items || []).map(i => `<div><div class="flex justify-between"><span>${i.qty} × ${i.name}</span><span>${i.qty * i.price} ج.م</span></div>${i.notes ? `<div class="text-amber-800 text-[11px]">ملاحظة: ${i.notes}</div>` : ''}</div>`).join('')}
          </div>
          <div class="flex justify-between items-center font-black text-base">
            <span>الإجمالي (شامل التوصيل ${o.deliveryFee}):</span>
            <span class="text-red-600">${o.total} ج.م</span>
          </div>
          <div class="grid grid-cols-3 gap-1.5 pt-1">
            <button onclick="loadOrderIntoPosForEdit('${id}', true)" class="bg-amber-400 hover:bg-amber-500 text-slate-950 py-2.5 rounded-xl font-black text-xs">✏️ تعديل</button>
            <button onclick="rejectOnlineOrder('${id}')" class="bg-slate-200 hover:bg-slate-300 text-slate-800 py-2.5 rounded-xl font-black text-xs">❌ رفض</button>
            <button onclick="acceptOnlineOrder('${id}')" class="bg-emerald-600 hover:bg-emerald-700 text-white py-2.5 rounded-xl font-black text-xs shadow">✅ قبول وطباعة</button>
          </div>
        </div>
      `).join('');
    }

    window.acceptOnlineOrder = async (orderId) => {
      const order = state.orders[orderId];
      if (!order) return;

      const counterRef = ref(db, 'meta/dailyCounter');
      let assignedNum = 1;
      await runTransaction(counterRef, (curr) => {
        assignedNum = curr || 1;
        return assignedNum + 1;
      });

      const updatedData = {
        orderNumber: assignedNum,
        date: todayStr(),
        paymentMethod: order.paymentMethod || 'cash',
        status: 'preparing',
        settledInVault: false,
        acceptedAt: Date.now()
      };
      await update(ref(db, `orders/${orderId}`), updatedData);

      if (order.customer?.phone1) {
        const phone1 = order.customer.phone1;
        const existing = Object.entries(state.customers).find(([k, c]) => k === phone1 || c.phone1 === phone1 || c.phone === phone1);
        if (existing) {
          await update(ref(db, `customers/${existing[0]}`), { ...order.customer, ordersCount: (existing[1].ordersCount || 0) + 1 });
        } else {
          await set(ref(db, `customers/${phone1}`), { ...order.customer, ordersCount: 1, blocked: false });
        }
      }

      const fullOrder = { id: orderId, ...order, ...updatedData };
      recordOrderInMonthLedger(fullOrder);
      persistLocalSnapshot();
      await triggerSeparatedPrint(fullOrder);
      showToastModal(`تم قبول الطلب الأونلاين برقم #${assignedNum} وطباعته`, '✅');
    };

    window.rejectOnlineOrder = async (orderId) => {
      if (!confirm('هل أنت متأكد من رفض هذا الطلب؟')) return;
      await update(ref(db, `orders/${orderId}`), { status: 'rejected' });
      showToastModal('تم رفض الطلب الأونلاين', '❌');
    };

    function renderActiveDelivery() {
      const grid = document.getElementById('activeDeliveryGrid');
      if (!grid) return;
      const list = Object.entries(state.orders).filter(([_, o]) => o && o.type === 'delivery' && (o.status === 'preparing' || o.status === 'out_for_delivery'));
      if (list.length === 0) {
        grid.innerHTML = '<div class="col-span-full bg-white p-10 rounded-2xl text-center font-bold text-slate-400">لا توجد أوردرات دليفري نشطة حالياً</div>';
        return;
      }

      const driverOpts = Object.entries(state.drivers).map(([did, d]) => `<option value="${did}">${d.name}</option>`).join('');

      grid.innerHTML = list.map(([id, o]) => `
        <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm space-y-3">
          <div class="flex justify-between items-center">
            <span class="bg-slate-900 text-amber-400 font-black px-3 py-1 rounded-lg text-base">#${o.orderNumber}</span>
            <span class="px-2.5 py-1 rounded-lg text-xs font-black ${o.status === 'out_for_delivery' ? 'bg-blue-100 text-blue-800' : 'bg-amber-100 text-amber-800'}">
              ${o.status === 'out_for_delivery' ? `🛵 في الطريق (${o.driverName}) ${o.driverAccepted ? '✅' : '🔔 يرن...'}` : '👨‍🍳 قيد التحضير'}
            </span>
          </div>
          <div class="text-xs font-bold text-slate-700 space-y-1">
            <div>👤 <b>${o.customer?.name}</b> - ${o.customer?.phone1}</div>
            <div>📍 ${o.customer?.zoneName} - ${o.customer?.address}</div>
            <div>💰 المطلوب: <b class="text-red-600 text-sm">${o.total} ج.م</b> (${o.paymentMethod === 'visa' ? '💳 فيزا' : '💵 نقدي'})</div>
          </div>
          <div class="flex gap-2">
            <select id="assignDriver_${id}" class="flex-1 p-2 border rounded-xl text-xs font-black bg-slate-50">
              <option value="">-- اختر الطيار --</option>
              ${driverOpts}
            </select>
            <button onclick="dispatchDriver('${id}')" class="bg-blue-600 text-white px-3 py-2 rounded-xl text-xs font-black">إرسال للطيار</button>
          </div>
          <div class="grid grid-cols-3 gap-1.5">
            <button onclick='reprintKitchenOnlyById("${id}")' class="bg-orange-500 text-white py-2 rounded-xl text-xs font-black">👨‍🍳 بون تحضير</button>
            <button onclick="markOrderDelivered('${id}')" class="bg-emerald-600 text-white py-2 rounded-xl text-xs font-black">✅ تم التسليم</button>
